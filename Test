        [HttpPost]
        public ActionResult SaveData(int EmpId,string Name,string HRA,string DA,string Basic,string cross, HttpPostedFileBase Pic , bool IsActive,string Country,string State)
        {

            Dictionary<string, string> dic = new Dictionary<string, string>();
            dic["Status"] = "";
            dic["Msg"] = "";
            var tempPath = "";
            if (Pic != null)
            {

           
            var filepath = Server.MapPath("~/Upload");
           
            var FName = Path.GetFileName(Pic.FileName);
            var FullDPath = Path.Combine(filepath,FName);
            if (!Directory.Exists(filepath))
            {
                Directory.CreateDirectory(filepath);

            }
            Pic.SaveAs(FullDPath);
             tempPath = "/Upload/" + FName;

            }

            conn.Open();
            SqlCommand cmd = new SqlCommand("USP_insertUpdateData", conn);
            cmd.CommandType = CommandType.StoredProcedure;
            cmd.Parameters.AddWithValue("@Name",Name);
            cmd.Parameters.AddWithValue("@HRA",HRA);
            cmd.Parameters.AddWithValue("@DA",DA);
            cmd.Parameters.AddWithValue("@Basic",Basic);
            cmd.Parameters.AddWithValue("@CrossSalary", cross);
            cmd.Parameters.AddWithValue("@IsActive",IsActive?"1":"0");
            cmd.Parameters.AddWithValue("@Country",Country);
            cmd.Parameters.AddWithValue("@State", State);
            cmd.Parameters.AddWithValue("@ImagePath", tempPath);
            SqlDataAdapter sda = new SqlDataAdapter(cmd);

            DataTable dt = new DataTable();
            sda.Fill(dt);
            conn.Close();

            if (dt.Rows.Count > 0)
            {
                dic["Msg"] = dt.Rows[0]["Msg"].ToString();
            }
            return Json(dic, JsonRequestBehavior.AllowGet);

