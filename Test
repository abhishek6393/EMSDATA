  function saveData() {

    var formdata = new FormData();
    formdata.append("Name", $("#txtname").val());  // fixed
    formdata.append("HRA", $("#txtHRA").val());
    formdata.append("DA", $("#txtDA").val());
    formdata.append("EmpId", $("#hfEmpID").val()); // case match
    formdata.append("Basic", $("#txtBasicSalary").val());
    formdata.append("Country", $("#ddlCountry").val());
    formdata.append("State", $("#ddlState").val());
    formdata.append("IsActive", $("#chActive").is(':checked'));
    formdata.append("cross", $("#txtCrossSalry").val());  // lower case

      var file = $("#Pic").get(0).files[0];
      formdata.append("Pic", file);

    $.ajax({
        url: '@Url.Action("SaveData", "Home")',
        type: 'POST',
        contentType: false,
        processData: false,
        data: formdata,
        success: function (resp) {
            alert(resp.Msg);
        },
        error: function () {
            alert("error in save data...");
        }
    });
    }


    function BindCountry() {

        $.ajax({
            url: '@Url.Action("BindCountry", "Home")',
            type: 'post',
            data: {},
            success: function (dt) {
                var data = JSON.parse(dt);
                for (var i = 0; i < data.length; i++) {
                    $("#ddlCountry").append(" <option value=" + data[i]["Country"] + ">"+ data[i]["Country"] + "</option > ")
                }

            },
            error: function () {
                alert("error in bind country...")
            }

        })
    }


       function BindState() {

       $.ajax({
           url: '@Url.Action("BindState", "Home")',
           type: 'post',
           data: { Country: $("#ddlCountry").val() },
           success: function (dt) {
               var data = JSON.parse(dt);
               $("#ddlState").empty().append('<option value="">--Select--</option>');
               for (var i = 0; i < data.length; i++) {
                   $("#ddlState").append(" <option value=" + data[i]["State"] + ">" + data[i]["State"] + "</option > ")
               }

           },
