Create Database TempData

Use TempData



Create table Emp(EmpId Int identity , Name Varchar(200),HRA Numeric(18,2),DA Numeric(18,2),Basic Numeric(18,2),
CrossSalary Numeric(18,2),IsActive Bit Default 0,ImagePath Varchar(50)
)
alter table Emp Add Country Varchar(50),State Varchar(50)
alter Proc USP_insertUpdateData
@EmpId int =0,
@Name Varchar(200),
@HRA Numeric(18,2),
@DA Numeric(18,2),
@Basic Numeric(18,2),
@CrossSalary Numeric(18,2),
@IsActive Bit = 0,
@ImagePath Varchar(50),
@Country Varchar(50),
@State Varchar(50)
As
Begin
Declare @status Varchar(10)='ERROR',@msg Varchar(200)=''
if @EmpId=0
Begin
	Insert into Emp(Name,HRA,DA,Basic,CrossSalary,IsActive,ImagePath,Country,State)
	Values(@Name,@HRA,@DA,@Basic,@CrossSalary,@IsActive,@ImagePath,@Country,@State)
	Set @status='SUCCESS';
	Set @msg='Data Saved Successfully';
End
Else

Begin
Update Emp set 	Name=@Name,HRA=@HRA ,DA=@DA,Basic=@Basic ,CrossSalary=@CrossSalary 
     ,IsActive=@IsActive,ImagePath=@ImagePath ,Country=@Country,State=@State
	Where EmpId=@EmpId

	Set @status='SUCCESS';
	Set @msg='Data update Successfully';
End

Select @msg As msg
End


Create Proc USP_ShowData

@EmpId Int
As 

Begin
If @EmpId =0
Begin
	Select * from Emp  
End
else
Begin
	Select * from Emp  where EmpId=@EmpId
End
End


