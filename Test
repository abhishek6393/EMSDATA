               alert("error in bind country...")
           }

       })




   }
    function ShowData() {

    $.ajax({
        url: '@Url.Action("ShowData", "Home")',
        type: 'post',
        data: { Country: $("#hfEmpID").val() },
        success: function (dt) {
            var data = JSON.parse(dt);
            $("#TBody").empty();
            for (var i = 0; i < data.length; i++) {
                $("#TBody").append(" <tr>  <td><img  src='" + data[i]["ImagePath"]+"' /></td>  <td><button onclick=Edit(" + data[i]["EmpId"] +")>Edit</button></td><td>" + data[i]["Name"] + "</td ><td>" + data[i]["HRA"] + "</td ><td>" + data[i]["DA"] + "</td ><td>" + data[i]["Basic"] + "</td ><td>" + data[i]["CrossSalary"] + "</td ><td>" + data[i]["Country"] + "</td ><td>" + data[i]["State"] +"</td ></tr > ")
            }

